{
  "manifest_version": 3,
  "name": "Geyma",
  "version": "0.2.1",
  "description": "Inventário local do Google Fotos e do iCloud Fotos para verificar se suas fotos estão protegidas em dois lugares.",
  "action": { "default_title": "Abrir o painel do Geyma" },
  "background": { "service_worker": "src/sw.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["https://photos.google.com/*", "https://www.icloud.com/*"],
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*", "https://www.icloud.com/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://photos.google.com/*", "https://www.icloud.com/*"],
      "js": ["src/page/relay.js"],
      "run_at": "document_start"
    }
  ]
}
