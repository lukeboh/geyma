{
  "manifest_version": 3,
  "name": "Geyma",
  "version": "0.3.17",
  "description": "Inventário local do Google Fotos e do iCloud Fotos para verificar se suas fotos estão protegidas em dois lugares.",
  "action": { "default_title": "Abrir o painel do Geyma" },
  "background": { "service_worker": "src/sw.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "permissions": ["storage", "unlimitedStorage", "tabs", "power", "debugger"],
  "host_permissions": ["https://photos.google.com/*", "https://www.icloud.com/*", "https://photos.fife.usercontent.google.com/*", "https://lh3.googleusercontent.com/*", "https://*.icloud-content.com/*", "https://video-downloads.googleusercontent.com/*"],
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["src/page/relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.icloud.com/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://www.icloud.com/*"],
      "js": ["src/page/relay.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["src/page/envio.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.icloud.com/*"],
      "js": ["src/page/envio.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
